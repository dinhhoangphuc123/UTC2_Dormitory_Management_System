<!DOCTYPE html>
<html lang="vi" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Hệ thống Quản lý Ký túc xá UTC2 - Phân hiệu TP.HCM: đăng ký nội trú, hợp đồng, hóa đơn, điện nước." />
    <meta name="theme-color" content="#0B2A5B" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <title>@(ViewData["Title"] ?? "Hệ thống Quản lý Ký túc xá UTC2 - Phân hiệu TP.HCM")</title>

    <!-- Preload fonts: Roboto -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet" />

    <!-- Tailwind CSS qua CDN: tiện cho demo; lên production nên chuyển sang build tĩnh
         (Tailwind CLI / Vite) để giảm tải CDN và tránh cảnh báo CSP. -->
    <script src="~/js/tailwind.min.js" asp-append-version="true"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Roboto"', 'sans-serif'],
                        headline: ['"Roboto"', 'sans-serif'],
                        mebius: ['"Roboto"', 'sans-serif'],
                        mono: ['"Roboto"', 'sans-serif'],
                        serif: ['"Roboto"', 'sans-serif']
                    },
                    fontSize: {
                        'xs': ['0.8125rem', { lineHeight: '1.25rem' }],
                        'sm': ['0.9375rem', { lineHeight: '1.375rem' }],
                        'base': ['1.0625rem', { lineHeight: '1.625rem' }],
                        'lg': ['1.1875rem', { lineHeight: '1.75rem' }],
                        'xl': ['1.3125rem', { lineHeight: '1.875rem' }],
                        '2xl': ['1.625rem', { lineHeight: '2.125rem' }],
                        '3xl': ['2rem', { lineHeight: '2.5rem' }]
                    },
                    colors: {
                        primary: '#00163a',
                        'primary-container': '#0b2a5b',
                        'primary-hover': '#143f8c',
                        secondary: '#375ba9',
                        'brand-dark': '#071a38',
                        'brand-bg': '#0b1523',
                        'brand-sidebar': '#081b33'
                    }
                }
            }
        }
    </script>

    <!-- Custom KTX Theme Styles -->
    <link rel="stylesheet" href="~/css/ktx-theme.css" asp-append-version="true" />

    <!-- Dark mode hydration before render -->
    <script>
        (function () {
            var savedTheme = localStorage.getItem('utc2_dorm_theme');
            var legacyDark = localStorage.getItem('ktx_dark_mode');
            var isDark = savedTheme === 'dark' || (savedTheme === null && legacyDark === 'true') || (savedTheme === null && legacyDark === null && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
            if (isDark) {
                document.documentElement.classList.add('dark');
                document.documentElement.style.colorScheme = 'dark';
            } else {
                document.documentElement.classList.remove('dark');
                document.documentElement.style.colorScheme = 'light';
            }
        })();
    </script>
</head>
<body class="h-full bg-[#F4F5F7] dark:bg-[#0B0F1A] text-[#0B0F1A] dark:text-[#E8EAF0] transition-colors duration-200">
    @RenderBody()

    <!-- Convert Material Symbol ligature labels into local SVG icons. -->
    <script src="~/js/ktx-icon-renderer.js" asp-append-version="true"></script>
    <script src="~/js/ktx-extended-views.js" asp-append-version="true"></script>
    <script src="~/js/ktx-student-views.js" asp-append-version="true"></script>
    <!-- Core App JS -->
    <script src="~/js/ktx-app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
